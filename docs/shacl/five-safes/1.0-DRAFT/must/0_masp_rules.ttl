        sh:message """Dataset: prov:wasDerivedFrom (MASP rule #prop_prov-wasDerivedFrom_Dataset)""" ;
    ] .

<urn:masp-shacl:five-safes:class_IdentifiedAsset> a sh:NodeShape ;
    sh:name """Identified asset""" ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { ?this a <http://schema.org/CreativeWork> . FILTER((REGEX(STR(?this), \"^[A-Za-z][A-Za-z0-9+.-]*:\", \"\") || REGEX(REPLACE(STR(?this), \"^.*/([^/]+)/?$\", \"$1\"), \"^[A-Za-z][A-Za-z0-9+.-]*:\", \"\"))) }""" ] ;
    sh:property [
        sh:path <http://schema.org/name> ;
        sh:name """Identified asset: name""" ;
        sh:description """The asset SHOULD carry a name.""" ;
        sh:nodeKind sh:Literal ;
        sh:message """Identified asset: name (MASP rule #prop_name_IdentifiedAsset)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/version> ;
        sh:name """Identified asset: version""" ;
        sh:description """A versioned asset, such as a protocol, software or a released extract, SHOULD carry version as text, using the label the asset already has.""" ;
        sh:nodeKind sh:Literal ;
        sh:message """Identified asset: version (MASP rule #prop_version_IdentifiedAsset)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/author> ;
        sh:name """Identified asset: author""" ;
        sh:description """A held or produced software or trained-model asset SHOULD carry author where known.""" ;
        sh:message """Identified asset: author (MASP rule #prop_author_IdentifiedAsset)""" ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/ns/prov#wasDerivedFrom> ;
        sh:name """Identified asset: prov:wasDerivedFrom""" ;
        sh:description """On a derived asset, SHOULD identify its source where derivation was observed or attested, and MUST be used only on that basis. MUST NOT link a packaged copy to the asset it encodes.""" ;
        sh:or ( [ sh:class <http://schema.org/MediaObject> ] [ sh:node <urn:masp-shacl:five-safes:class_Dataset> ] [ sh:class <http://schema.org/CreativeWork> ] ) ;
        sh:message """Identified asset: prov:wasDerivedFrom (MASP rule #prop_prov-wasDerivedFrom_IdentifiedAsset)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/additionalType> ;
        sh:name """Identified asset: additionalType""" ;
        sh:description """Where the kind of agreement or policy matters, SHOULD refer to a published term, such as a Data Privacy Vocabulary agreement class.""" ;
        sh:message """Identified asset: additionalType (MASP rule #prop_additionalType_IdentifiedAsset)""" ;
    ] .


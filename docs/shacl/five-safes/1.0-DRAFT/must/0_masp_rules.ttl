        sh:name """Referenced RO-Crate: dct:isVersionOf""" ;
        sh:description """MUST copy the activity record identifier present on the referenced RO-Crate's Root Data Entity.""" ;
        sh:maxCount 1 ;
        sh:message """Referenced RO-Crate: dct:isVersionOf (MASP rule #prop_dct-isVersionOf_ReferencedCrate)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/datePublished> ;
        sh:name """Referenced RO-Crate: datePublished""" ;
        sh:description """MUST copy the datePublished present on the referenced RO-Crate's Root Data Entity. For a snapshot a decision used or an exchange transferred, it MUST NOT be later than that process's endTime.""" ;
        sh:maxCount 1 ;
        sh:or ( [ sh:nodeKind sh:Literal ] [ sh:nodeKind sh:Literal ] ) ;
        sh:message """Referenced RO-Crate: datePublished (MASP rule #prop_datePublished_ReferencedCrate)""" ;
    ] ;
    sh:property [
        sh:path <http://purl.org/dc/terms/conformsTo> ;
        sh:name """Referenced RO-Crate: conformsTo""" ;
        sh:description """SHOULD include the versionless https://w3id.org/ro/crate; MUST NOT include a version-specific RO-Crate IRI. Application-profile IRIs MAY be present as hints.""" ;
        sh:message """Referenced RO-Crate: conformsTo (MASP rule #prop_conformsTo_ReferencedCrate)""" ;
    ] .

<urn:masp-shacl:five-safes:class_NodeProvenanceCrate> a sh:NodeShape ;
    sh:name """Node provenance RO-Crate""" ;
    sh:class <http://schema.org/Dataset> ;
    sh:node <urn:masp-shacl:five-safes:class_ReferencedCrate> ;
    sh:property [
        sh:path <http://schema.org/about> ;
        sh:name """Node provenance RO-Crate: about""" ;
        sh:description """MUST identify the activity record, an exact process or an exact asset that is the subject matter of the node provenance RO-Crate, as absolute IRIs.""" ;
        sh:minCount 1 ;
        sh:message """Node provenance RO-Crate: about (MASP rule #prop_about_NodeProvenanceCrate)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/publisher> ;
        sh:name """Node provenance RO-Crate: publisher""" ;
        sh:description """SHOULD identify the Organization that published the node provenance RO-Crate.""" ;
        sh:class <http://schema.org/Organization> ;
        sh:message """Node provenance RO-Crate: publisher (MASP rule #prop_publisher_NodeProvenanceCrate)""" ;
    ] .

<urn:masp-shacl:five-safes:class_Person> a sh:NodeShape ;
    sh:name """Person""" ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { ?this a <http://schema.org/Person> . FILTER((REGEX(STR(?this), \"^[A-Za-z][A-Za-z0-9+.-]*:\", \"\") || REGEX(REPLACE(STR(?this), \"^.*/([^/]+)/?$\", \"$1\"), \"^[A-Za-z][A-Za-z0-9+.-]*:\", \"\"))) }""" ] ;
    sh:property [
        sh:path <http://schema.org/name> ;
        sh:name """Person: name""" ;
        sh:description """The person's name, or a pseudonym such as \"Checker 17\".""" ;
        sh:nodeKind sh:Literal ;
        sh:message """Person: name (MASP rule #prop_name_Person)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/affiliation> ;
        sh:name """Person: affiliation""" ;
        sh:description """MAY reference the exact Organization described in the RO-Crate.""" ;
        sh:class <http://schema.org/Organization> ;
        sh:message """Person: affiliation (MASP rule #prop_affiliation_Person)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/sameAs> ;
        sh:name """Person: sameAs""" ;
        sh:description """MAY record an external Web URL whose page unambiguously indicates the entity's identity.""" ;
        sh:message """Person: sameAs (MASP rule #prop_sameAs_Person)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/identifier> ;
        sh:name """Person: identifier""" ;
        sh:description """Other external identifiers MAY be given as PropertyValue entities.""" ;
        sh:class <http://schema.org/PropertyValue> ;
        sh:message """Person: identifier (MASP rule #prop_identifier_Person)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/hasCredential> ;
        sh:name """Person: hasCredential""" ;
        sh:description """The exact credentials awarded to this person that are relevant to access.""" ;
        sh:class <http://schema.org/EducationalOccupationalCredential> ;
        sh:message """Person: hasCredential (MASP rule #prop_hasCredential_Person)""" ;
    ] .

<urn:masp-shacl:five-safes:class_Organization> a sh:NodeShape ;
    sh:name """Organization""" ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { ?this a <http://schema.org/Organization> . FILTER((REGEX(STR(?this), \"^[A-Za-z][A-Za-z0-9+.-]*:\", \"\") || REGEX(REPLACE(STR(?this), \"^.*/([^/]+)/?$\", \"$1\"), \"^[A-Za-z][A-Za-z0-9+.-]*:\", \"\"))) }""" ] ;
    sh:property [
        sh:path <http://schema.org/name> ;
        sh:name """Organization: name""" ;
        sh:description """The organisation's name.""" ;
        sh:nodeKind sh:Literal ;
        sh:message """Organization: name (MASP rule #prop_name_Organization)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/sameAs> ;
        sh:name """Organization: sameAs""" ;
        sh:description """MAY record an external Web URL whose page unambiguously indicates the entity's identity.""" ;
        sh:message """Organization: sameAs (MASP rule #prop_sameAs_Organization)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/identifier> ;
        sh:name """Organization: identifier""" ;
        sh:description """Other external identifiers MAY be given as PropertyValue entities.""" ;
        sh:class <http://schema.org/PropertyValue> ;
        sh:message """Organization: identifier (MASP rule #prop_identifier_Organization)""" ;
    ] .

<urn:masp-shacl:five-safes:class_IdentifierPropertyValue> a sh:NodeShape ;
    sh:name """Identifier (PropertyValue)""" ;
    sh:targetClass <http://schema.org/PropertyValue> ;
    sh:property [
        sh:path <http://schema.org/value> ;
        sh:name """Identifier (PropertyValue): value""" ;
        sh:description """MUST carry the identifier.""" ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message """Identifier (PropertyValue): value (MASP rule #prop_value_IdentifierPropertyValue)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/propertyID> ;
        sh:name """Identifier (PropertyValue): propertyID""" ;
        sh:description """SHOULD identify the identifier's scheme.""" ;
        sh:or ( [ sh:nodeKind sh:IRIOrLiteral ] [ sh:nodeKind sh:Literal ] ) ;
        sh:message """Identifier (PropertyValue): propertyID (MASP rule #prop_propertyID_IdentifierPropertyValue)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/url> ;
        sh:name """Identifier (PropertyValue): url""" ;
        sh:description """SHOULD give the identifier's resolvable form where one exists.""" ;
        sh:nodeKind sh:IRIOrLiteral ;
        sh:message """Identifier (PropertyValue): url (MASP rule #prop_url_IdentifierPropertyValue)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/name> ;
        sh:name """Identifier (PropertyValue): name""" ;
        sh:description """Names the kind of identifier.""" ;
        sh:nodeKind sh:Literal ;
        sh:message """Identifier (PropertyValue): name (MASP rule #prop_name_IdentifierPropertyValue)""" ;
    ] .

<urn:masp-shacl:five-safes:class_Credential> a sh:NodeShape ;
    sh:name """Credential""" ;
    sh:targetClass <http://schema.org/EducationalOccupationalCredential> ;
    sh:property [
        sh:path <http://schema.org/name> ;
        sh:name """Credential: name""" ;
        sh:description """Names the credential.""" ;
        sh:nodeKind sh:Literal ;
        sh:message """Credential: name (MASP rule #prop_name_Credential)""" ;
    ] ;
    sh:property [
        sh:path <http://purl.org/dc/terms/valid> ;
        sh:name """Credential: dct:valid""" ;
        sh:description """SHOULD be one closed interval in start/end form when the credential has exactly one continuous validity period with both endpoints known, the start not later than the end. MUST be omitted where only one endpoint is known; a missing endpoint must not be inferred.""" ;
        sh:maxCount 1 ;
        sh:message """Credential: dct:valid (MASP rule #prop_dct-valid_Credential)""" ;
    ] ;
    sh:property [
        sh:path <http://purl.org/dc/terms/valid> ;
        sh:name """Credential: dct:valid (Closed validity interval)""" ;
        sh:qualifiedValueShape [ sh:pattern """^(\\d{4}-\\d{2}-\\d{2}\\/\\d{4}-\\d{2}-\\d{2}|\\d{4}-\\d{2}-\\d{2}T[0-9:.]+(Z|[+-]\\d{2}:\\d{2})\\/\\d{4}-\\d{2}-\\d{2}T[0-9:.]+(Z|[+-]\\d{2}:\\d{2}))$""" ] ;
        sh:qualifiedMinCount 1 ;
        sh:message """Credential: dct:valid must have 1 to any values matching #value_closed_interval (MASP rule #prop_dct-valid_Credential)""" ;
    ] .

<urn:masp-shacl:five-safes:class_Location> a sh:NodeShape ;
    sh:name """Location""" ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { ?this a <http://schema.org/Thing> . ?this a <http://www.w3.org/ns/prov#Location> . FILTER((REGEX(STR(?this), \"^[A-Za-z][A-Za-z0-9+.-]*:\", \"\") || REGEX(REPLACE(STR(?this), \"^.*/([^/]+)/?$\", \"$1\"), \"^[A-Za-z][A-Za-z0-9+.-]*:\", \"\"))) }""" ] ;
    sh:property [
        sh:path <http://schema.org/name> ;
        sh:name """Location: name""" ;
        sh:description """Names the location.""" ;
        sh:nodeKind sh:Literal ;
        sh:message """Location: name (MASP rule #prop_name_Location)""" ;
    ] .

<urn:masp-shacl:five-safes:class_Process> a sh:NodeShape ;
    sh:name """Process""" ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { ?this a <http://www.w3.org/ns/prov#Activity> . FILTER((REGEX(STR(?this), \"^[A-Za-z][A-Za-z0-9+.-]*:\", \"\") || REGEX(REPLACE(STR(?this), \"^.*/([^/]+)/?$\", \"$1\"), \"^[A-Za-z][A-Za-z0-9+.-]*:\", \"\"))) }""" ] ;
    sh:property [
        sh:path <http://schema.org/agent> ;
        sh:name """Process: agent""" ;
        sh:description """The people or organisations that directly performed or operated the process. A role, account or pool of people MUST NOT be used; an automated step is attributed to the operating organisation, with the software as instrument.""" ;
        sh:minCount 1 ;
        sh:or ( [ sh:class <http://schema.org/Person> ] [ sh:class <http://schema.org/Organization> ] ) ;
        sh:message """Process: agent (MASP rule #prop_agent_Process)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/actionStatus> ;
        sh:name """Process: actionStatus""" ;
        sh:description """Exactly one of http://schema.org/ActiveActionStatus, CompletedActionStatus or FailedActionStatus, written as {\"@id\": ...}; PotentialActionStatus MUST NOT be used. A process keeps its @id as it moves from active to completed or failed.""" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message """Process: actionStatus (MASP rule #prop_actionStatus_Process)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/name> ;
        sh:name """Process: name""" ;
        sh:description """SHOULD say what happened, in words.""" ;
        sh:nodeKind sh:Literal ;
        sh:message """Process: name (MASP rule #prop_name_Process)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/description> ;
        sh:name """Process: description""" ;
        sh:description """MAY give further detail, such as the command run.""" ;
        sh:nodeKind sh:Literal ;
        sh:message """Process: description (MASP rule #prop_description_Process)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/object> ;
        sh:name """Process: object""" ;
        sh:description """SHOULD identify what the process acted on. An asset that needs an identity beyond this RO-Crate is referenced through an entity with an absolute IRI.""" ;
        sh:or ( [ sh:class <http://schema.org/MediaObject> ] [ sh:node <urn:masp-shacl:five-safes:class_Dataset> ] [ sh:class <http://schema.org/CreativeWork> ] [ sh:class <http://schema.org/CreativeWork> ] [ sh:class <http://schema.org/SoftwareApplication> ] [ sh:class <http://schema.org/SoftwareSourceCode> ] [ sh:node <urn:masp-shacl:five-safes:class_ReferencedCrate> ] [ sh:class <http://schema.org/Person> ] [ sh:class <http://schema.org/Organization> ] ) ;
        sh:message """Process: object (MASP rule #prop_object_Process)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/result> ;
        sh:name """Process: result""" ;
        sh:description """A CreateAction with CompletedActionStatus that produced an asset MUST identify it. An anticipated, suppressed or withheld output MUST NOT appear as result.""" ;
        sh:or ( [ sh:class <http://schema.org/MediaObject> ] [ sh:node <urn:masp-shacl:five-safes:class_Dataset> ] [ sh:class <http://schema.org/CreativeWork> ] [ sh:class <http://schema.org/SoftwareApplication> ] [ sh:class <http://schema.org/SoftwareSourceCode> ] [ sh:node <urn:masp-shacl:five-safes:class_ReferencedCrate> ] [ sh:class <http://schema.org/EducationalOccupationalCredential> ] ) ;
        sh:message """Process: result (MASP rule #prop_result_Process)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/instrument> ;
        sh:name """Process: instrument""" ;
        sh:description """SHOULD identify the exact protocol, software or other asset that actually helped perform the process; applicability alone does not make an asset an instrument.""" ;
        sh:or ( [ sh:class <http://schema.org/SoftwareApplication> ] [ sh:class <http://schema.org/SoftwareSourceCode> ] [ sh:class <http://schema.org/CreativeWork> ] [ sh:class <http://schema.org/MediaObject> ] ) ;
        sh:message """Process: instrument (MASP rule #prop_instrument_Process)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/provider> ;
        sh:name """Process: provider""" ;
        sh:description """MUST identify the Organization that provided or operated the environment or service, where the process was carried out within a TRE or one of its nodes.""" ;
        sh:class <http://schema.org/Organization> ;
        sh:message """Process: provider (MASP rule #prop_provider_Process)""" ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/ns/prov#atLocation> ;
        sh:name """Process: prov:atLocation""" ;
        sh:description """MAY identify the runtime location where the process ran.""" ;
        sh:class <http://schema.org/Thing> ;
        sh:message """Process: prov:atLocation (MASP rule #prop_prov-atLocation_Process)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/startTime> ;
        sh:name """Process: startTime""" ;
        sh:description """SHOULD give when the process actually began; never an anticipated time.""" ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message """Process: startTime (MASP rule #prop_startTime_Process)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/endTime> ;
        sh:name """Process: endTime""" ;
        sh:description """MUST be present where actionStatus is CompletedActionStatus or FailedActionStatus; MUST NOT be present where ActiveActionStatus.""" ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message """Process: endTime (MASP rule #prop_endTime_Process)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/additionalType> ;
        sh:name """Process: additionalType""" ;
        sh:description """MAY refer to the exact IRI of a published term for a more specific kind of process, without changing its published meaning.""" ;
        sh:message """Process: additionalType (MASP rule #prop_additionalType_Process)""" ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/ns/prov#wasInformedBy> ;
        sh:name """Process: prov:wasInformedBy""" ;
        sh:description """An earlier process that informed this one: the request a decision answers, a decision it reverses, a check it drew on, or the dispatch a receipt resulted from. Asserted only where observed or attested.""" ;
        sh:message """Process: prov:wasInformedBy (MASP rule #prop_prov-wasInformedBy_Process)""" ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/ns/prov#used> ;
        sh:name """Process: prov:used""" ;
        sh:description """What the process actually used, such as an agreement it drew on. A snapshot is identified only if it existed and was actually used.""" ;
        sh:or ( [ sh:class <http://schema.org/MediaObject> ] [ sh:node <urn:masp-shacl:five-safes:class_Dataset> ] [ sh:class <http://schema.org/CreativeWork> ] [ sh:node <urn:masp-shacl:five-safes:class_ReferencedCrate> ] ) ;
        sh:message """Process: prov:used (MASP rule #prop_prov-used_Process)""" ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/ns/prov#qualifiedAssociation> ;
        sh:name """Process: prov:qualifiedAssociation""" ;
        sh:description """When planned work is executed, the execution MUST link to the plan through at least one association.""" ;
        sh:class <http://www.w3.org/ns/prov#Association> ;
        sh:message """Process: prov:qualifiedAssociation (MASP rule #prop_prov-qualifiedAssociation_Process)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/actionStatus> ;
        sh:name """Process: actionStatus (Process status)""" ;
        sh:qualifiedValueShape [ sh:pattern """^http:\\/\\/schema\\.org\\/(Active|Completed|Failed)ActionStatus$""" ] ;
        sh:qualifiedMinCount 1 ;
        sh:message """Process: actionStatus must have 1 to any values matching #value_action_status (MASP rule #prop_actionStatus_Process)""" ;
    ] .

<urn:masp-shacl:five-safes:class_Association> a sh:NodeShape ;
    sh:name """Association""" ;
    sh:targetClass <http://www.w3.org/ns/prov#Association> ;
    sh:property [
        sh:path <http://www.w3.org/ns/prov#agent> ;
        sh:name """Association: prov:agent""" ;
        sh:description """Exactly one agent, which is also an agent of the execution.""" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class <http://schema.org/Person> ] [ sh:class <http://schema.org/Organization> ] ) ;
        sh:message """Association: prov:agent (MASP rule #prop_prov-agent_Association)""" ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/ns/prov#hadPlan> ;
        sh:name """Association: prov:hadPlan""" ;
        sh:description """Exactly one plan, identifying the exact plan version.""" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class <http://schema.org/CreativeWork> ;
        sh:message """Association: prov:hadPlan (MASP rule #prop_prov-hadPlan_Association)""" ;
    ] .

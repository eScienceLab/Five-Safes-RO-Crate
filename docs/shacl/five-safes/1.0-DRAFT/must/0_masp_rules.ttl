        sh:name """File: author""" ;
        sh:description """A held or produced software or trained-model asset SHOULD carry author where known.""" ;
        sh:or ( [ sh:class <http://schema.org/Person> ] [ sh:class <http://schema.org/Organization> ] ) ;
        sh:message """File: author (MASP rule #prop_author_File)""" ;

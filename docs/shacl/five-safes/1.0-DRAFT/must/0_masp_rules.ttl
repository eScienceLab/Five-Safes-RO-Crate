<urn:masp-shacl:five-safes:class_File> a sh:NodeShape ;
    sh:name """File""" ;
    sh:targetClass <http://schema.org/MediaObject> ;
    sh:property [
        sh:path <http://schema.org/name> ;
        sh:name """File: name""" ;
        sh:description """The file or data SHOULD carry a name.""" ;
        sh:nodeKind sh:Literal ;
        sh:message """File: name (MASP rule #prop_name_File)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/version> ;
        sh:name """File: version""" ;
        sh:description """A versioned asset SHOULD carry version as text, using the label it already has. (A Dataset that is an RO-Crate's root or a reference to another RO-Crate carries an integer instead.)""" ;
        sh:or ( [ sh:nodeKind sh:Literal ] [ sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:int ] ) ] ) ;
        sh:message """File: version (MASP rule #prop_version_File)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/author> ;
        sh:name """File: author""" ;
        sh:description """A held or produced software or trained-model asset SHOULD carry author where known.""" ;
        sh:message """File: author (MASP rule #prop_author_File)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/encodesCreativeWork> ;
        sh:name """File: encodesCreativeWork""" ;
        sh:description """On a packaged copy of an identified asset, MUST identify the exact asset version it encodes, typed CreativeWork or a subtype. A file holding several separately identified outputs lists each.""" ;
        sh:or ( [ sh:class <http://schema.org/CreativeWork> ] [ sh:class <http://schema.org/CreativeWork> ] ) ;
        sh:message """File: encodesCreativeWork (MASP rule #prop_encodesCreativeWork_File)""" ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/ns/prov#wasDerivedFrom> ;
        sh:name """File: prov:wasDerivedFrom""" ;
        sh:description """On a derived asset, SHOULD identify its source where derivation was observed or attested, and MUST be used only on that basis. MUST NOT link a packaged copy to the asset it encodes.""" ;
        sh:or ( [ sh:class <http://schema.org/MediaObject> ] [ sh:node <urn:masp-shacl:five-safes:class_Dataset> ] [ sh:class <http://schema.org/CreativeWork> ] ) ;
        sh:message """File: prov:wasDerivedFrom (MASP rule #prop_prov-wasDerivedFrom_File)""" ;
    ] .

<urn:masp-shacl:five-safes:class_Dataset> a sh:NodeShape ;
    sh:name """Dataset""" ;

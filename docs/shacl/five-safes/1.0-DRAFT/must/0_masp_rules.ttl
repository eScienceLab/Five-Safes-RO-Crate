@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Generated by masp_to_shacl.py from docs/ro-crate-metadata.json (Five Safes RO-Crate 1.0-DRAFT)

<urn:masp-shacl:five-safes:class_MetadataDescriptor> a sh:NodeShape ;
    sh:name """Metadata descriptor""" ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { ?this a <http://schema.org/CreativeWork> . FILTER(REPLACE(STR(?this), \"^.*/([^/]+)/?$\", \"$1\") = \"ro-crate-metadata.json\") }""" ] ;
    sh:property [
        sh:path <http://purl.org/dc/terms/conformsTo> ;
        sh:name """Metadata descriptor: conformsTo""" ;
        sh:description """The RO-Crate version: https://w3id.org/ro/crate/1.3. Profiles, including this one, are declared on the Root Data Entity instead.""" ;
        sh:minCount 1 ;
        sh:message """Metadata descriptor: conformsTo (MASP rule #prop_conformsTo_MetadataDescriptor)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/about> ;
        sh:name """Metadata descriptor: about""" ;
        sh:description """The Root Data Entity. Its @id and the descriptor's about MUST use exactly the same value.""" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class <http://schema.org/Dataset> ;
        sh:message """Metadata descriptor: about (MASP rule #prop_about_MetadataDescriptor)""" ;
    ] ;
    sh:property [
        sh:path <http://purl.org/dc/terms/conformsTo> ;
        sh:name """Metadata descriptor: conformsTo (RO-Crate 1.3)""" ;
        sh:qualifiedValueShape [ sh:in ( <https://w3id.org/ro/crate/1.3> ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message """Metadata descriptor: conformsTo must have 1 to any values matching #value_ro_crate_1_3 (MASP rule #prop_conformsTo_MetadataDescriptor)""" ;
    ] .

<urn:masp-shacl:five-safes:class_RootDataEntity> a sh:NodeShape ;
    sh:name """Root Data Entity""" ;
    sh:targetClass <https://github.com/crs4/rocrate-validator/profiles/ro-crate-1.2/RootDataEntity> ;
    sh:targetClass <https://github.com/crs4/rocrate-validator/profiles/ro-crate-1.3/RootDataEntity> ;
    sh:property [
        sh:path <http://schema.org/additionalType> ;
        sh:name """Root Data Entity: additionalType""" ;
        sh:description """MUST include https://w3id.org/5s-crate/1.0-DRAFT#EgressSnapshot on an egress snapshot, written as {\"@id\": ...}; MUST NOT include it on a working record or internal snapshot.""" ;
        sh:message """Root Data Entity: additionalType (MASP rule #prop_additionalType_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://purl.org/dc/terms/conformsTo> ;
        sh:name """Root Data Entity: conformsTo""" ;
        sh:description """MUST include this profile (https://w3id.org/5s-crate/1.0-DRAFT) and the versioned IRI of each selected module; other application profiles MAY be present. Each MUST be described by a Profile entity.""" ;
        sh:minCount 1 ;
        sh:or ( [ sh:class <http://www.w3.org/ns/dx/prof/Profile> ] [ sh:in ( <https://w3id.org/5s-crate/1.0-DRAFT> ) ] ) ;
        sh:message """Root Data Entity: conformsTo (MASP rule #prop_conformsTo_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/identifier> ;
        sh:name """Root Data Entity: identifier""" ;
        sh:description """MUST include exactly one canonical RO-Crate identifier: an absolute IRI in {\"@id\": ...} form that identifies this representation and is not a PropertyValue. Other identifiers the record is known by MAY be added as PropertyValue entities.""" ;
        sh:minCount 1 ;
        sh:message """Root Data Entity: identifier (MASP rule #prop_identifier_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://purl.org/dc/terms/isVersionOf> ;
        sh:name """Root Data Entity: dct:isVersionOf""" ;
        sh:description """The activity record identifier: an absolute IRI, the same in every representation of the record.""" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message """Root Data Entity: dct:isVersionOf (MASP rule #prop_dct-isVersionOf_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/name> ;
        sh:name """Root Data Entity: name""" ;
        sh:description """Names the activity record.""" ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message """Root Data Entity: name (MASP rule #prop_name_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/description> ;
        sh:name """Root Data Entity: description""" ;
        sh:description """Describes the work the activity record covers.""" ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message """Root Data Entity: description (MASP rule #prop_description_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/dateCreated> ;
        sh:name """Root Data Entity: dateCreated""" ;
        sh:description """When this representation was created: for a snapshot, when it was taken from the working record or, for an egress snapshot, created from its source. An ISO 8601 Date or DateTime with a timezone.""" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:nodeKind sh:Literal ] [ sh:nodeKind sh:Literal ] ) ;
        sh:message """Root Data Entity: dateCreated (MASP rule #prop_dateCreated_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/dateModified> ;
        sh:name """Root Data Entity: dateModified""" ;
        sh:description """MUST be present, exactly once, on a working record that has changed since creation (the most recent actual change); MUST NOT be present on a snapshot.""" ;
        sh:maxCount 1 ;
        sh:or ( [ sh:nodeKind sh:Literal ] [ sh:nodeKind sh:Literal ] ) ;
        sh:message """Root Data Entity: dateModified (MASP rule #prop_dateModified_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/datePublished> ;
        sh:name """Root Data Entity: datePublished""" ;
        sh:description """When this representation was first made available as an RO-Crate, including within a restricted system. A snapshot becomes immutable at this time.""" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:nodeKind sh:Literal ] [ sh:nodeKind sh:Literal ] ) ;
        sh:message """Root Data Entity: datePublished (MASP rule #prop_datePublished_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/license> ;
        sh:name """Root Data Entity: license""" ;
        sh:description """SHOULD be present on a published RO-Crate: an open licence, or restrictive, TRE-specific conditions of access.""" ;
        sh:message """Root Data Entity: license (MASP rule #prop_license_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/publisher> ;
        sh:name """Root Data Entity: publisher""" ;
        sh:description """SHOULD identify the Organization that published this representation.""" ;
        sh:message """Root Data Entity: publisher (MASP rule #prop_publisher_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/version> ;
        sh:name """Root Data Entity: version""" ;
        sh:description """MUST be present, exactly once, on a snapshot, as a positive JSON integer: 1 for the first internal snapshot, greater than the predecessor's for later ones, and greater than its source's for an egress snapshot. MUST NOT be present on a working record.""" ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:int ] ) ;
        sh:message """Root Data Entity: version (MASP rule #prop_version_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://purl.org/pav/previousVersion> ;
        sh:name """Root Data Entity: pav:previousVersion""" ;
        sh:description """MUST identify, exactly once, the canonical identifier of the preceding internal snapshot on an internal snapshot after the first; MUST NOT be present otherwise.""" ;
        sh:maxCount 1 ;
        sh:message """Root Data Entity: pav:previousVersion (MASP rule #prop_pav-previousVersion_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/ns/prov#wasDerivedFrom> ;
        sh:name """Root Data Entity: prov:wasDerivedFrom""" ;
        sh:description """MUST identify, exactly once, the canonical identifier of the source internal snapshot on an egress snapshot; not used on other representations.""" ;
        sh:maxCount 1 ;
        sh:message """Root Data Entity: prov:wasDerivedFrom (MASP rule #prop_prov-wasDerivedFrom_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/hasPart> ;
        sh:name """Root Data Entity: hasPart""" ;
        sh:description """MUST be present if the RO-Crate holds or refers to data entities: each MUST be reachable from the Root Data Entity through hasPart, directly or through nested Datasets. Includes referenced RO-Crates.""" ;
        sh:message """Root Data Entity: hasPart (MASP rule #prop_hasPart_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/mentions> ;
        sh:name """Root Data Entity: mentions""" ;
        sh:description """MUST be present if the RO-Crate records any processes: every process recorded in this RO-Crate, including one that other processes already link to. The Root Data Entity is where a consumer finds all the processes.""" ;
        sh:message """Root Data Entity: mentions (MASP rule #prop_mentions_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://purl.org/dc/terms/conformsTo> ;
        sh:name """Root Data Entity: conformsTo (Five Safes RO-Crate core profile)""" ;
        sh:qualifiedValueShape [ sh:in ( <https://w3id.org/5s-crate/1.0-DRAFT> ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message """Root Data Entity: conformsTo must have 1 to any values matching #value_core_profile (MASP rule #prop_conformsTo_RootDataEntity)""" ;
    ] .

<urn:masp-shacl:five-safes:class_Profile> a sh:NodeShape ;
    sh:name """Profile""" ;
    sh:targetClass <http://www.w3.org/ns/dx/prof/Profile> ;
    sh:property [
        sh:path <http://schema.org/name> ;
        sh:name """Profile: name""" ;
        sh:description """The profile's name.""" ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message """Profile: name (MASP rule #prop_name_Profile)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/version> ;
        sh:name """Profile: version""" ;
        sh:description """The profile's version label, such as 1.0-DRAFT.""" ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message """Profile: version (MASP rule #prop_version_Profile)""" ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/ns/dx/prof/isProfileOf> ;
        sh:name """Profile: isProfileOf""" ;
        sh:description """On a module's Profile entity, MUST identify the Five Safes RO-Crate core (https://w3id.org/5s-crate/1.0-DRAFT).""" ;
        sh:class <http://www.w3.org/ns/dx/prof/Profile> ;
        sh:message """Profile: isProfileOf (MASP rule #prop_isProfileOf_Profile)""" ;
    ] .

    sh:property [
        sh:path <http://schema.org/encodesCreativeWork> ;
        sh:name """File: encodesCreativeWork""" ;
        sh:description """On a packaged copy of an identified asset, MUST identify the exact asset version it encodes, typed CreativeWork or a subtype. A file holding several separately identified outputs lists each.""" ;
        sh:or ( [ sh:class <http://schema.org/CreativeWork> ] [ sh:class <http://schema.org/CreativeWork> ] ) ;
        sh:message """File: encodesCreativeWork (MASP rule #prop_encodesCreativeWork_File)""" ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/ns/prov#wasDerivedFrom> ;
        sh:name """File: prov:wasDerivedFrom""" ;

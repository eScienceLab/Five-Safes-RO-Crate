<urn:masp-shacl:five-safes:class_File> a sh:NodeShape ;
    sh:name """File""" ;
    sh:targetClass <http://schema.org/MediaObject> ;
    sh:property [
        sh:path <http://schema.org/name> ;
        sh:name """File: name""" ;
        sh:description """The file or data SHOULD carry a name.""" ;

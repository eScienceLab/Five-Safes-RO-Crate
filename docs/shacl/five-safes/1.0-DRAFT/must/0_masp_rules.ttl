        sh:message """File: name (MASP rule #prop_name_File)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/version> ;
        sh:name """File: version""" ;
        sh:description """A versioned asset SHOULD carry version as text, using the label it already has. (A Dataset that is an RO-Crate's root or a reference to another RO-Crate carries an integer instead.)""" ;
        sh:or ( [ sh:nodeKind sh:Literal ] [ sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:int ] ) ] ) ;

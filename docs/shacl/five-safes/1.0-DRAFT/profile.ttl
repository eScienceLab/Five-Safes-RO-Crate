@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/5s-crate/1.0-DRAFT> a prof:Profile ;
    rdfs:label """Five Safes RO-Crate""" ;
    rdfs:comment """An RO-Crate profile for recording and exchanging the activity and provenance of work in Trusted Research Environments (TREs): the assets they hold, the processes applied to them, and the people, organisations and agreements involved.""" ;
    prof:isProfileOf <https://w3id.org/ro/crate/1.3> ;
    prof:isTransitiveProfileOf <https://w3id.org/ro/crate/1.3> , <https://w3id.org/ro/crate/1.2> ;
    prof:hasToken """five-safes""" .

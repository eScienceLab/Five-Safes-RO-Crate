        sh:message """Output (Dataset): additionalType (MASP rule #prop_additionalType_OutputDataset)""" ;
    ] ;
    sh:property [
        sh:path <https://w3id.org/dpv#hasRisk> ;
        sh:name """Output (Dataset): dpv:hasRisk""" ;
        sh:description """MAY identify a published risk class, such as https://w3id.org/statbarnsdc#LowCount, that applies to this output.""" ;
        sh:message """Output (Dataset): dpv:hasRisk (MASP rule #prop_dpv-hasRisk_OutputDataset)""" ;
    ] ;
    sh:property [
        sh:path <https://w3id.org/dpv/risk#hasControl> ;
        sh:name """Output (Dataset): risk:hasControl""" ;
        sh:description """MAY identify a published control class, such as https://w3id.org/statbarnsdc#Suppression, actually applied in producing this output, only where the RO-Crate records no CreateAction that applied it.""" ;
        sh:message """Output (Dataset): risk:hasControl (MASP rule #prop_risk-hasControl_OutputDataset)""" ;
    ] ;
    sh:property [
        sh:path <https://w3id.org/dpv#isMitigatedByMeasure> ;
        sh:name """Output (Dataset): dpv:isMitigatedByMeasure""" ;
        sh:description """MUST NOT be used on an output: measures that could be applied, but were not, are not recorded.""" ;
        sh:maxCount 0 ;
        sh:message """Output (Dataset): dpv:isMitigatedByMeasure (MASP rule #prop_dpv-isMitigatedByMeasure_OutputDataset)""" ;
    ] .


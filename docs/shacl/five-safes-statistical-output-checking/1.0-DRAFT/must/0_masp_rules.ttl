<urn:masp-shacl:five-safes-statistical-output-checking:class_MetadataDescriptor> a sh:NodeShape ;
    sh:name """Metadata descriptor""" ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { ?this a <http://schema.org/CreativeWork> . FILTER(REPLACE(STR(?this), \"^.*/([^/]+)/?$\", \"$1\") = \"ro-crate-metadata.json\") }""" ] ;
    sh:property [
        sh:path <http://schema.org/about> ;
        sh:name """Metadata descriptor: about""" ;
        sh:description """The Root Data Entity.""" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class <http://schema.org/Dataset> ;
        sh:message """Metadata descriptor: about (MASP rule #prop_about_MetadataDescriptor)""" ;
    ] .

<urn:masp-shacl:five-safes-statistical-output-checking:class_RootDataEntity> a sh:NodeShape ;
    sh:name """Root Data Entity""" ;
    sh:targetClass <https://github.com/crs4/rocrate-validator/profiles/ro-crate-1.2/RootDataEntity> ;
    sh:targetClass <https://github.com/crs4/rocrate-validator/profiles/ro-crate-1.3/RootDataEntity> ;
    sh:property [
        sh:path <http://purl.org/dc/terms/conformsTo> ;
        sh:name """Root Data Entity: conformsTo""" ;
        sh:description """MUST include the module's IRI (https://w3id.org/5s-crate/1.0-DRAFT/modules/statistical-output-checking) alongside the core profile's, each described by a Profile entity.""" ;
        sh:minCount 1 ;
        sh:message """Root Data Entity: conformsTo (MASP rule #prop_conformsTo_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/mentions> ;
        sh:name """Root Data Entity: mentions""" ;
        sh:description """A working record or snapshot that declares this module MUST record at least one statistical output check under mentions.""" ;
        sh:message """Root Data Entity: mentions (MASP rule #prop_mentions_RootDataEntity)""" ;
    ] ;
    sh:property [
        sh:path <http://purl.org/dc/terms/conformsTo> ;
        sh:name """Root Data Entity: conformsTo (Statistical Output Checking module)""" ;
        sh:qualifiedValueShape [ sh:in ( <https://w3id.org/5s-crate/1.0-DRAFT/modules/statistical-output-checking> ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message """Root Data Entity: conformsTo must have 1 to any values matching #value_module_profile (MASP rule #prop_conformsTo_RootDataEntity)""" ;
    ] .

<urn:masp-shacl:five-safes-statistical-output-checking:class_StatisticalOutputCheck> a sh:NodeShape ;
    sh:name """Statistical output check""" ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { ?this a <http://schema.org/AssessAction> . ?this a <http://www.w3.org/ns/prov#Activity> . }""" ] ;
    sh:property [
        sh:path <http://schema.org/additionalType> ;
        sh:name """Statistical output check: additionalType""" ;
        sh:description """MUST include the module term https://w3id.org/5s-crate/1.0-DRAFT/modules/statistical-output-checking#StatisticalOutputCheck, which is how the module selects the checks it applies to. SHOULD also include https://w3id.org/dpv/risk#RiskAssessment where the check identified, analysed or evaluated disclosure risk; further published terms MAY be added.""" ;
        sh:minCount 1 ;
        sh:message """Statistical output check: additionalType (MASP rule #prop_additionalType_StatisticalOutputCheck)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/object> ;
        sh:name """Statistical output check: object""" ;
        sh:description """Each output checked, through an entity with an absolute IRI identifying the asset and version examined.""" ;
        sh:minCount 1 ;
        sh:or ( [ sh:class <http://schema.org/Dataset> ] [ sh:node <urn:masp-shacl:five-safes-statistical-output-checking:class_OutputWork> ] ) ;
        sh:message """Statistical output check: object (MASP rule #prop_object_StatisticalOutputCheck)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/result> ;
        sh:name """Statistical output check: result""" ;
        sh:description """Where actionStatus is CompletedActionStatus, SHOULD identify at least one finding for each object; MAY identify a report; MUST NOT identify an AuthorizeAction or RejectAction.""" ;
        sh:or ( [ sh:node <urn:masp-shacl:five-safes-statistical-output-checking:class_Finding> ] [ sh:class <http://schema.org/MediaObject> ] ) ;
        sh:message """Statistical output check: result (MASP rule #prop_result_StatisticalOutputCheck)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/instrument> ;
        sh:name """Statistical output check: instrument""" ;
        sh:description """SHOULD identify the exact version of the policy or configuration that set the check's criteria, and any software, where either helped perform the check.""" ;
        sh:or ( [ sh:node <urn:masp-shacl:five-safes-statistical-output-checking:class_Policy> ] [ sh:class <http://schema.org/SoftwareApplication> ] ) ;
        sh:message """Statistical output check: instrument (MASP rule #prop_instrument_StatisticalOutputCheck)""" ;
    ] ;
    sh:property [
        sh:path <https://w3id.org/dpv/risk#hasRiskEvaluation> ;
        sh:name """Statistical output check: risk:hasRiskEvaluation""" ;
        sh:description """MAY identify a published kind of evaluation the check applied to its outputs, such as https://w3id.org/statbarnsdc#MinimumThresholdCheck.""" ;
        sh:message """Statistical output check: risk:hasRiskEvaluation (MASP rule #prop_risk-hasRiskEvaluation_StatisticalOutputCheck)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/additionalType> ;
        sh:name """Statistical output check: additionalType (Statistical output check term)""" ;
        sh:qualifiedValueShape [ sh:in ( <https://w3id.org/5s-crate/1.0-DRAFT/modules/statistical-output-checking#StatisticalOutputCheck> ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message """Statistical output check: additionalType must have 1 to any values matching #value_check_term (MASP rule #prop_additionalType_StatisticalOutputCheck)""" ;
    ] .

<urn:masp-shacl:five-safes-statistical-output-checking:class_Finding> a sh:NodeShape ;
    sh:name """Finding""" ;
    sh:class <http://schema.org/CreativeWork> ;
    sh:property [
        sh:path <http://schema.org/additionalType> ;
        sh:name """Finding: additionalType""" ;
        sh:description """MUST include exactly one term from the outcome set: #Pass, #Fail or #NeedsReview.""" ;
        sh:minCount 1 ;
        sh:message """Finding: additionalType (MASP rule #prop_additionalType_Finding)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/about> ;
        sh:name """Finding: about""" ;
        sh:description """Exactly one output: the output the finding concerns, which MUST be an object of the check that lists the finding.""" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class <http://schema.org/Dataset> ] [ sh:node <urn:masp-shacl:five-safes-statistical-output-checking:class_OutputWork> ] ) ;
        sh:message """Finding: about (MASP rule #prop_about_Finding)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/description> ;
        sh:name """Finding: description""" ;
        sh:description """SHOULD say what was found, in words. Cell coordinates, cell values and variable names belong in the report, not in metadata.""" ;
        sh:nodeKind sh:Literal ;
        sh:message """Finding: description (MASP rule #prop_description_Finding)""" ;
    ] ;
    sh:property [
        sh:path <https://w3id.org/dpv/risk#hasRiskEvaluation> ;
        sh:name """Finding: risk:hasRiskEvaluation""" ;
        sh:description """MAY identify the published kind of evaluation this finding reports on, when one finding is recorded per evaluation.""" ;
        sh:message """Finding: risk:hasRiskEvaluation (MASP rule #prop_risk-hasRiskEvaluation_Finding)""" ;
    ] ;
    sh:property [
        sh:path <https://w3id.org/dpv#isMitigatedByMeasure> ;
        sh:name """Finding: dpv:isMitigatedByMeasure""" ;
        sh:description """MUST NOT be used on a finding: measures that could be applied are not recorded.""" ;
        sh:maxCount 0 ;
        sh:message """Finding: dpv:isMitigatedByMeasure (MASP rule #prop_dpv-isMitigatedByMeasure_Finding)""" ;
    ] ;
    sh:property [
        sh:path <http://schema.org/additionalType> ;
        sh:name """Finding: additionalType (Exactly one outcome term)""" ;
        sh:qualifiedValueShape [ sh:pattern """^https:\\/\\/w3id\\.org\\/5s-crate\\/1\\.0-DRAFT\\/modules\\/statistical-output-checking#(Pass|Fail|NeedsReview)$""" ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message """Finding: additionalType must have 1 to 1 values matching #value_one_outcome (MASP rule #prop_additionalType_Finding)""" ;
    ] .

<urn:masp-shacl:five-safes-statistical-output-checking:class_OutputDataset> a sh:NodeShape ;
    sh:name """Output (Dataset)""" ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { ?this a <http://schema.org/Dataset> . FILTER((REGEX(STR(?this), \"^[A-Za-z][A-Za-z0-9+.-]*:\", \"\") || REGEX(REPLACE(STR(?this), \"^.*/([^/]+)/?$\", \"$1\"), \"^[A-Za-z][A-Za-z0-9+.-]*:\", \"\"))) }""" ] ;
    sh:property [
        sh:path <http://schema.org/additionalType> ;

<urn:masp-shacl:five-safes-statistical-output-checking:class-counts> a sh:NodeShape ;
    sh:name """Number of entities of each type""" ;
    sh:targetClass <https://github.com/crs4/rocrate-validator/profiles/ro-crate-1.2/RootDataEntity> ;
    sh:targetClass <https://github.com/crs4/rocrate-validator/profiles/ro-crate-1.3/RootDataEntity> ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:message """The crate must have 1 to any number of Statistical output check entities""" ;
        sh:select """SELECT $this WHERE { $this a ?rootType . { SELECT (COUNT(DISTINCT ?x) AS ?n) WHERE { ?x a <http://schema.org/AssessAction> . ?x a <http://www.w3.org/ns/prov#Activity> . } } FILTER(?n < 1) }""" ] .

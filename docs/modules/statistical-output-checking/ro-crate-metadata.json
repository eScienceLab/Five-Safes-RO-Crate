      "@type": "DefinedTerm",
      "name": "Fail",
      "description": "The output did not meet at least one criterion the check applied to it. It is not a refusal.",
      "url": "https://w3id.org/5s-crate/1.0-DRAFT/modules/statistical-output-checking#outcomes",
      "inDefinedTermSet": [

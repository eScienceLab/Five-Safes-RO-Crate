      "@type": "DefinedTerm",
      "name": "Pass",
      "description": "The output met every criterion the check applied to it. It is not permission to release.",
      "url": "https://w3id.org/5s-crate/1.0-DRAFT/modules/statistical-output-checking#outcomes",
      "inDefinedTermSet": [
